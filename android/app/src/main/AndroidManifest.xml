<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Job 5: invisible to strangers. Runs the foreground service behind
         the "reachable" notification, which is the honest, always-visible
         answer to whether Ferry is advertising and accepting connections. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Job 5: invisible to strangers. Android 13 and later require this to
         show the notification the foreground service posts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Job 1: use the phone's files like any other folder. Ferry cannot
         serve the shared folders to the Mac without this. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Job 1: use the phone's files like any other folder. The Wi-Fi
         transport that carries the file traffic needs a network socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Job 2: the cable always works. The transport indicator has to know
         whether Wi-Fi is up to decide which path is active. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Job 1: use the phone's files like any other folder. mDNS discovery,
         which finds the Mac on Wi-Fi, needs multicast. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Job 4: trust a device once. Reading the Mac's QR code is one of the
         two ways to pair, and it is the quicker one when both devices are
         in reach. Asked for at the moment a person taps to scan, never at
         first run, so a person who pairs by code is never asked at all. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- A camera is not required to install Ferry. Pairing by code needs
         none, and every other job works without one, so a phone with a
         broken or absent camera is not excluded from the Play listing. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Job 5: invisible to strangers, docs/engine-contract.md item 18. A
         device that paired at home stays silent in a cafe. Android hands
         over the Wi-Fi network name only to an app holding this
         permission, so the phone can tell the engine which network it is
         on. Asked for at the moment pairing first starts, never at first
         run, so a person who never pairs is never asked.

         docs/audits/oss-capability.md M1. An app that targets API 31 or
         later and asks for fine location without also declaring coarse
         location has that request ignored by Android, so the coarse
         permission is declared too, and MainActivity asks for both in one
         request. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".FerryApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Ferry">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Ferry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Job 1, docs/ux-fix-plan.md item 1. A share from any app
                 becomes one push_files call to the paired Mac. singleTop
                 above sends a second share to the same instance's
                 onNewIntent, so one share never builds a second engine. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Job 5: invisible to strangers. While this service runs, the
             engine advertises and accepts connections, and one ongoing
             notification says so. Android 15 and later cap a dataSync
             service at six hours a day, then call the service's own
             onTimeout, which ReachableService implements to stop cleanly
             and say why. The Pixel 3 XL runs Android 12, which has no such
             cap. docs/audits/oss-capability.md M3. -->
        <service
            android:name=".ReachableService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Job 8: the Mac's folder inside the phone's own apps. This puts
             every paired Mac's shared folders in the Files app and in every
             app's open and save dialog, per docs/engine-contract.md item
             19. MANAGE_DOCUMENTS is a signature permission the system's own
             document picker holds, so it is the only caller the system lets
             in, and the picker hands a chosen file's URI to another app
             through a grant. -->
        <provider
            android:name=".provider.FerryDocumentsProvider"
            android:authorities="app.ferry.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>
