<?xml version="1.0" encoding="utf-8"?>
<!--
    Every user-facing string in the Ferry Android app. A string inline in a
    view is a bug (docs/design.md). Words follow docs/voice.md; most are
    taken directly from docs/ia.md and docs/components.md.

    Text a screen actually generates at runtime (a paused reason, a
    three-part error, a device name, a fingerprint) is not here. It lives in
    model/SampleState.kt for now, standing in for what the Rust core will
    send once it is linked, the same way design/errors.json holds that text
    today. What follows is the fixed wording around that data: titles,
    labels, button text, and the templates a number is placed into.
-->
<resources>
    <string name="app_name">Ferry</string>

    <!-- Debug-only. Not a docs/voice.md string: it names a developer
         control, not something the finished app says. -->
    <string name="debug_sample_data_label">Sample data</string>

    <!-- Shared actions, reused wherever the same button appears. -->
