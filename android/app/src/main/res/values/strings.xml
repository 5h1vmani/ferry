<?xml version="1.0" encoding="utf-8"?>
<!--
    Every user-facing string in the Ferry Android app. A string inline in a
    view is a bug (docs/design.md). Words follow docs/voice.md; most are
    taken directly from docs/ia.md and docs/components.md.

    Text that describes one error is not here. It lives in the generated
    table in Errors.kt, built from design/errors.json, so the phone and the
    Mac say the same words for the same error code. What follows is the
    fixed wording around the engine's data: titles, labels, button text, and
    the templates a number is placed into.
-->
<resources>
    <string name="app_name">Ferry</string>

    <!-- Shared actions, reused wherever the same button appears. -->
    <string name="action_pair">Pair</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_confirm">Confirm</string>
    <string name="action_retry">Retry</string>
    <string name="action_forget_this_mac">Forget this Mac</string>
    <string name="action_open_settings">Open settings</string>
    <!-- docs/voice.md rule 9 asks a button to name a verb and rules out
         "Continue". docs/ia.md's phone first run names this control
         "Continue" in as many words, and it is the specification, so the
         word here is the one it gives. -->
    <string name="action_continue">Continue</string>
    <string name="cd_back">Back</string>

    <!-- TransportBadge, docs/components.md. -->
    <string name="transport_usb">USB</string>
    <string name="transport_wifi">Wi-Fi</string>
    <string name="transport_connecting">Connecting</string>
    <string name="transport_not_reachable">Not reachable</string>
    <string name="transport_speed_value">%1$d MB/s</string>
    <string name="cd_transport_usb_idle">Connected over USB</string>
    <string name="cd_transport_usb_moving">Connected over USB, %1$d megabytes per second</string>
    <string name="cd_transport_wifi_idle">Connected over Wi-Fi</string>
    <string name="cd_transport_wifi_moving">Connected over Wi-Fi, %1$d megabytes per second</string>
    <string name="cd_transport_connecting">Connecting</string>
    <string name="cd_transport_not_reachable">Not reachable</string>

    <!-- DeviceRow, docs/components.md. -->
    <string name="device_last_seen">Last seen %1$s ago</string>

    <!-- Sizes and durations, for the numbers the engine reports. Units are
         decimal, the way a disk and a network count them. -->
    <string name="size_bytes">%1$d B</string>
    <string name="size_kilobytes">%1$s kB</string>
    <string name="size_megabytes">%1$s MB</string>
    <string name="size_gigabytes">%1$s GB</string>
    <string name="size_terabytes">%1$s TB</string>
    <string name="duration_under_a_minute">under a minute</string>
    <plurals name="duration_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <plurals name="duration_hours">
        <item quantity="one">%1$d hour</item>
        <item quantity="other">%1$d hours</item>
    </plurals>
    <plurals name="duration_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>

    <!-- ProgressLine, docs/components.md. The engine reports one file per
         transfer, with a byte count, so the active line counts bytes rather
         than the "3 of 120 files" a folder-sized transfer would show. -->
    <string name="progress_queued">Queued.</string>
    <string name="progress_active">%1$s of %2$s</string>
    <string name="progress_paused">Paused. %1$s</string>
    <string name="progress_paused_plain">Paused.</string>
    <string name="cd_progress_transferring_percent">Transferring, %1$d percent</string>

    <!-- An error code the generated table does not hold. That means
         design/errors.json and the engine have drifted apart. -->
    <string name="error_unknown_stopped">Ferry has a fault.</string>
    <string name="error_unknown_why">It reported the code %1$s, which this version does not know.</string>
    <string name="error_unknown_todo">Report this. Nothing you did caused it.</string>

    <!-- PairingCode, docs/components.md. Digit words spell the code for a
         screen reader, one digit at a time. -->
    <string-array name="digit_words">
        <item>zero</item>
        <item>one</item>
        <item>two</item>
        <item>three</item>
        <item>four</item>
        <item>five</item>
        <item>six</item>
        <item>seven</item>
        <item>eight</item>
        <item>nine</item>
    </string-array>
    <string name="cd_pairing_code">Pairing code, %1$s</string>
    <!-- Adapted from docs/components.md's "Confirm this matches on the
         phone.": that line is written from the Mac's screen. This is the
         phone's own screen, confirming against the Mac's, so it names the
         Mac instead. -->
    <string name="pairing_code_instruction">Confirm this matches on the Mac.</string>
    <string name="pairing_confirmed_label">Confirmed.</string>

    <!-- EmptyState, docs/components.md. -->
    <string name="devices_empty_line">No Mac paired.</string>
    <string name="transfers_empty_line">No transfers.</string>

    <!-- Devices screen, docs/ia.md. -->
    <string name="devices_title">Devices</string>
    <string name="cd_settings_action">Settings</string>

    <!-- Device (detail) screen, docs/ia.md. -->
    <string name="device_section_transfers">Transfers</string>
    <string name="device_section_info">Info</string>
    <string name="device_info_paired_label">Paired %1$s</string>
    <string name="device_info_fingerprint_label">Key fingerprint</string>

    <!-- Pairing screen, docs/ia.md phone first run, steps 5-7. -->
    <string name="pairing_title">Pairing</string>
    <string name="pairing_waiting_title">Pairing on. Open Ferry on the Mac.</string>
    <string name="pairing_short_code_label">Short code</string>

    <!-- First run, docs/ia.md phone step 1. The doc names the two things
         Ferry needs and why, and names the control Continue. These lines
         say the same in docs/voice.md's plain form. -->
    <string name="first_run_title">Ferry needs two things.</string>
    <string name="first_run_all_files">All files access, so Ferry can serve the shared folders to the Mac.</string>
    <string name="first_run_notification">A notification, so Ferry can stay reachable.</string>

    <!-- The reachable foreground service, docs/ia.md. -->
    <string name="notification_channel_reachable">Reachable</string>
    <string name="notification_reachable_title">Ferry is reachable.</string>
    <string name="notification_action_turn_off">Turn off</string>

    <!-- Settings screen, docs/ia.md. -->
    <string name="settings_title">Settings</string>
    <string name="settings_reachable_label">Reachable</string>
    <string name="settings_reachable_caption">On: the phone advertises and accepts connections. Off: neither.</string>
    <string name="settings_shared_storage_label">Shared storage</string>
    <string name="settings_shared_storage_value">Internal storage</string>
    <string name="settings_shared_storage_caption">Not editable in phase 1.</string>
    <string name="settings_all_files_access_label">All files access</string>
    <string name="settings_status_granted">Granted</string>
    <string name="settings_status_not_granted">Not granted</string>
    <string name="settings_notifications_label">Notifications</string>
    <string name="settings_status_allowed">Allowed</string>
    <string name="settings_status_not_allowed">Not allowed</string>
</resources>
