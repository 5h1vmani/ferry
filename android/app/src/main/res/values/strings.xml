<?xml version="1.0" encoding="utf-8"?>
<!--
    Every user-facing string in the Ferry Android app. A string inline in a
    view is a bug (docs/design.md). Words follow docs/voice.md; most are
    taken directly from docs-v2/ia.md and docs-v2/components.md.

    Text that describes one error is not here. It lives in the generated
    table in Errors.kt, built from design/errors.json, so the phone and the
    Mac say the same words for the same error code. That includes the four
    QR pairing errors and the camera refusal: the phone names the code and
    reads the words, and composes no English of its own. What follows is the
    fixed wording around the engine's data: titles, labels, button text, and
    the templates a number is placed into.

    Same event, same words, both platforms. Every string added in this pass
    has a twin in the Mac's Strings.swift.
-->
<resources>
    <string name="app_name">Ferry</string>

    <!-- Shared actions, reused wherever the same button appears. -->
    <string name="action_pair">Pair</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_confirm">Confirm</string>
    <string name="action_retry">Retry</string>
    <!-- The Mac is named, not "this device": a phone holds one Mac, and
         the Mac's own control says "Forget this phone", so the same event
         says the same kind of thing on both platforms. -->
    <string name="action_forget_this_device">Forget this Mac</string>
    <string name="action_open_settings">Open settings</string>
    <!-- The Devices screen's share control, docs/ux-fix-plan.md item 1.
         Opens the system picker; the same words on the Mac name the Finder
         Services entry and the drop target's own control. -->
    <string name="action_send_files">Send files</string>

    <!-- A share that could not read one of its files, docs/ux-fix-plan.md
         item 1. This is an app-side fault, not an engine code, so its
         three parts live here rather than in the generated error table,
         the same way the Mac's own app-side words live in Strings.swift. -->
    <string name="share_unreadable_stopped">The share stopped.</string>
    <string name="share_unreadable_why">Ferry could not read %1$s from the app that shared it.</string>
    <string name="share_unreadable_todo">Save the file to the phone, then share it again.</string>
    <!-- The name share_unreadable_why names when the failure gives no file
         of its own, audit finding 2. -->
    <string name="share_generic_file_name">the shared file</string>

    <!-- A share whose intent carried no read grant, audit finding 1 of
         docs/audits/ux-gestures.md. -->
    <string name="share_not_granted_stopped">The share stopped.</string>
    <string name="share_not_granted_why">The app that shared did not give Ferry the right to read the file.</string>
    <string name="share_not_granted_todo">Share it from the phone\'s own Photos or Files app.</string>
    <string name="cd_back">Back</string>
    <!-- Between two facts on one line: "14:31 · 48 KB". -->
    <string name="dot_separator"> · </string>

    <!-- TransportBadge, docs-v2/components.md. -->
    <string name="transport_usb">USB</string>
    <string name="transport_wifi">Wi-Fi</string>
    <string name="transport_connecting">Connecting</string>
    <string name="transport_not_reachable">Not reachable</string>
    <string name="transport_speed_value">%1$d MB/s</string>
    <string name="cd_transport_usb_idle">Connected over USB</string>
    <string name="cd_transport_usb_moving">Connected over USB, %1$d megabytes per second</string>
    <string name="cd_transport_wifi_idle">Connected over Wi-Fi</string>
    <string name="cd_transport_wifi_moving">Connected over Wi-Fi, %1$d megabytes per second</string>
    <string name="cd_transport_connecting">Connecting</string>
    <string name="cd_transport_not_reachable">Not reachable</string>

    <!-- DeviceRow, docs-v2/components.md. The spare transport is stated
         beside the badge, never inside it: a badge that names two paths
         stops answering which one is carrying this. -->
    <string name="device_last_seen">Last seen %1$s ago</string>
    <string name="devices_spare_transport_wifi">Wi-Fi also available</string>
    <string name="devices_spare_transport_usb">USB also available</string>

    <!-- PresenceControl, docs-v2/components.md. Job 5's only control. It
         appears on Devices and in the notification, and both read one
         value, so both read these words. -->
    <string name="presence_advertising">Advertising</string>
    <string name="presence_not_advertising">Not advertising</string>
    <!-- Stated because the failure it causes is silent. Named by its real
         name: this phone, Wi-Fi, USB. -->
    <string name="presence_consequence">This phone cannot be found on Wi-Fi. USB still works.</string>
    <string name="presence_start">Start advertising</string>
    <string name="presence_stop">Stop advertising</string>
    <string name="cd_presence_on">Advertising, on</string>
    <string name="cd_presence_off">Not advertising, off. %1$s</string>
    <!-- Shared by PresenceControl, the reachable notification, and the
         Networks section of Settings: advertising is on, and reachability
         is quiet because this network is not trusted.
         docs/engine-contract.md, item 18. -->
    <string name="presence_quiet_on_network">Ferry is quiet on this network.</string>
    <string name="cd_presence_quiet">Advertising, on. %1$s</string>

    <!-- Sizes and durations, for the numbers the engine reports. Units are
         decimal, the way a disk and a network count them. -->
    <string name="size_bytes">%1$d B</string>
    <string name="size_kilobytes">%1$s kB</string>
    <string name="size_megabytes">%1$s MB</string>
    <string name="size_gigabytes">%1$s GB</string>
    <string name="size_terabytes">%1$s TB</string>
    <string name="duration_under_a_minute">under a minute</string>
    <plurals name="duration_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <plurals name="duration_hours">
        <item quantity="one">%1$d hour</item>
        <item quantity="other">%1$d hours</item>
    </plurals>
    <plurals name="duration_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <!-- How long a finished transfer took. Short forms, because these sit
         inside a line of other numbers: "12 files · 4.8 GB · 3 min". -->
    <string name="duration_seconds">%1$d s</string>
    <string name="duration_minutes_short">%1$d min</string>
    <string name="duration_hours_short">%1$d h %2$d min</string>

    <!-- ProgressLine and TransferRow, docs-v2/components.md. -->
    <string name="progress_queued">Queued.</string>
    <string name="progress_remaining">%1$s remaining</string>
    <string name="progress_paused">Paused. %1$s</string>
    <string name="progress_paused_plain">Paused.</string>
    <string name="cd_progress_transferring_percent">Transferring, %1$d percent</string>

    <!-- The Transfers section, docs-v2/ia.md. Origin is a word in the same
         type as the direction, because it is the same kind of fact: how
         this transfer came to exist. Job 7. -->
    <string name="transfers_direction_phone_to_mac">Phone to Mac</string>
    <string name="transfers_direction_mac_to_phone">Mac to phone</string>
    <string name="transfers_origin_automatic">Automatic</string>
    <string name="transfers_files_progress">%1$d of %2$d files</string>
    <string name="transfers_file_count">%1$d files</string>

    <!-- The chunk disclosure, docs-v2/ia.md. The bottom of the depth axis,
         one tap away and never in the way. -->
    <string name="chunks_show">Show chunks</string>
    <string name="chunks_verified">%1$d of %2$d verified</string>
    <string name="chunks_verified_summary">%1$d of %2$d chunks verified.</string>
    <string name="chunks_failed_chunk">Chunk %1$d failed to verify.</string>

    <!-- The access log, docs-v2/ia.md. L5, job 9.

         The subject is always named, never "you" and never an arrow: a log
         is read months later, out of context. The verbs are the file
         operations layer's own words, so a log line and a protocol trace
         say the same word. -->
    <string name="access_log_title">Access log</string>
    <string name="access_log_empty">No access yet.</string>
    <string name="access_log_retention">Kept for 30 days.</string>
    <string name="access_log_today">Today</string>
    <string name="access_log_yesterday">Yesterday</string>
    <string name="access_log_this_phone">This phone</string>
    <string name="access_log_sentence">%1$s %2$s %3$s</string>
    <string name="access_log_sentence_files">%1$s %2$s %3$s, %4$d files</string>
    <string name="access_log_entries">%1$d entries</string>
    <string name="access_verb_list">listed</string>
    <string name="access_verb_stat">checked</string>
    <string name="access_verb_read">read</string>
    <string name="access_verb_write">wrote</string>
    <string name="access_verb_truncate">truncated</string>
    <string name="access_verb_rename">renamed</string>
    <string name="access_verb_mkdir">created</string>
    <string name="access_verb_delete">deleted</string>

    <!-- An error code the generated table does not hold. That means
         design/errors.json and the engine have drifted apart. Same words
         as the Mac's common.unknownError* in Strings.swift: one event,
         one wording, on both platforms. -->
    <string name="error_unknown_stopped">The action stopped.</string>
    <string name="error_unknown_why">Ferry has no words for the code %1$s.</string>
    <string name="error_unknown_todo">Report this code.</string>

    <!-- PairingCode, docs-v2/components.md. Digit words spell the code for
         a screen reader, one digit at a time, so it can be compared
         against the other screen. -->
    <string-array name="digit_words">
        <item>zero</item>
        <item>one</item>
        <item>two</item>
        <item>three</item>
        <item>four</item>
        <item>five</item>
        <item>six</item>
        <item>seven</item>
        <item>eight</item>
        <item>nine</item>
    </string-array>
    <string name="cd_pairing_code">Pairing code, %1$s</string>
    <!-- This is the phone's own screen, confirming against the Mac's, so it
         names the Mac. -->
    <string name="pairing_code_instruction">Confirm this matches on the Mac.</string>
    <string name="pairing_confirmed_label">Confirmed.</string>

    <!-- Pairing, docs-v2/ia.md, Pairing, the phone.

         Two ways in, and every step offers the other one. Scanning is
         fewer steps when both devices are in reach, which is when pairing
         happens, so it is named first — but a refused camera, a Mac on a
         screen this phone cannot point at, and a person who would rather
         type all end up on the code path, and none of them should have to
         go back a screen to get there. -->
    <string name="pairing_title">Pairing</string>
    <string name="pairing_choose_title">Pair with a Mac.</string>
    <!-- No body line here: docs-v2/ia.md, Pairing, the phone, Choosing,
         lists the title and two controls only. The line this screen once
         carried, "Scanning is quicker...", named no count for "quicker",
         which docs/voice.md rule 5 refuses. -->
    <!-- Read before the location permission prompt fires, so the person
         knows why Ferry is asking. Pairing is the first moment that is
         worth asking, because only the Wi-Fi network name needs it. -->
    <string name="pairing_location_reason">Location, so Ferry can read the Wi-Fi name.</string>
    <string name="pairing_scan_the_code">Scan the Mac\'s code</string>
    <string name="pairing_scan_instead">Scan the Mac\'s code instead</string>
    <string name="pairing_use_code_instead">Use a pairing code instead</string>
    <string name="pairing_point_the_camera">Point the camera at the Mac\'s screen.</string>
    <string name="pairing_scanned">Code read.</string>
    <string name="pairing_scanned_named">%1$s found.</string>
    <!-- Asked once the scan's handshake has found the Mac and named it,
         above the same Confirm and Cancel controls the code method uses. -->
    <string name="pairing_scanned_confirm_question">Is this your Mac?</string>
    <string name="pairing_waiting_title">Pairing on. Open Ferry on the Mac.</string>
    <!-- Shown in place of pairing_waiting_title while the code method has
         been chosen but the service has not yet reported reachable: the
         engine has not begun pairing yet, whatever step this looks like,
         so this does not promise "Pairing on" before it is true. -->
    <string name="pairing_starting">Starting.</string>
    <!-- The only place this phone's random mDNS name is ever shown. A
         person in a room with three phones can tell which is theirs, and a
         wrong pick is safe anyway, because the six digits will not match. -->
    <string name="pairing_short_code_is">This phone appears on the Mac as</string>
    <!-- The two minute timeout, counted. Not "soon", which is an adjective
         standing in for a number. -->
    <string name="pairing_stops_in">Pairing stops in %1$s.</string>

    <!-- First run, docs-v2/ia.md, First run, phone.

         The control is "Grant access", not "Continue": rule 9 of
         docs/voice.md bans that word by name, and this button does one
         nameable thing. Skip exists because all files access can be
         refused and Devices must still work when it is.

         The camera is not asked for here. It is asked for when a person
         taps to scan, so this screen still names two things and a person
         who pairs by code is never asked for a camera at all. -->
    <string name="first_run_title">Ferry needs two things.</string>
    <string name="first_run_all_files_title">All files access</string>
    <string name="first_run_all_files_why">Ferry serves the shared folders to the Mac. Without it, every transfer fails.</string>
    <string name="first_run_notifications_title">Notifications</string>
    <string name="first_run_notifications_why">One notification says Ferry is reachable, and stops it.</string>
    <!-- A third thing exists, location, but it is asked for later, at
         pairing, not here: naming it now would make this "three things"
         with only two controls on screen. -->
    <string name="first_run_location_later">Location is asked separately, when pairing starts.</string>
    <string name="first_run_grant">Grant access</string>
    <string name="first_run_skip">Skip</string>

    <!-- EmptyState, docs-v2/components.md. -->
    <string name="devices_empty_line">No Mac paired.</string>
    <string name="transfers_empty_line">No transfers.</string>

    <!-- Devices screen, docs-v2/ia.md. -->
    <string name="devices_title">Devices</string>
    <string name="cd_settings_action">Settings</string>
    <string name="device_section_transfers">Transfers</string>
    <string name="device_info_paired_label">Paired %1$s</string>

    <!-- The reachable foreground service, docs-v2/ia.md. While it runs the
         phone is advertising, so the notification states that and offers
         the one action that changes it. The device is named rather than
         called "your phone", because a person may have two. -->
    <string name="notification_channel_reachable">Reachable</string>
    <string name="notification_advertising">%1$s is reachable over Wi-Fi.</string>
    <!-- The off state of the same notification: a state of the service,
         not its absence, so a person who tapped Stop from the shade has a
         way back. -->
    <string name="notification_not_advertising">Not advertising. %1$s cannot be found on Wi-Fi.</string>

    <!-- Transfer notifications, docs/ux-fix-plan.md item 2. One per batch,
         or per transfer outside a batch. Its title, progress line, and
         error words are the ones TransferRow already draws, from the
         strings above and the generated error table. -->
    <string name="notification_channel_transfers">Transfers</string>

    <!-- Settings screen, docs-v2/ia.md, Settings, the phone.

         Reachability has left this screen. It was a switch filed under
         preferences; it is a mode with a consequence, and it now lives
         where presence lives. -->
    <string name="settings_title">Settings</string>
    <string name="settings_group_this_phone">This phone</string>
    <string name="settings_group_permissions">Permissions</string>
    <string name="settings_group_record">Record</string>
    <string name="settings_group_paired">Paired</string>
    <string name="settings_name_label">Name</string>
    <string name="settings_shared_storage_label">Shared storage</string>
    <string name="settings_shared_storage_value">Internal storage</string>
    <string name="settings_shared_storage_caption">Not editable in phase 1.</string>
    <string name="settings_all_files_access_label">All files access</string>
    <string name="settings_status_granted">Granted</string>
    <string name="settings_status_not_granted">Not granted</string>
    <string name="settings_notifications_label">Notifications</string>
    <string name="settings_status_allowed">Allowed</string>
    <string name="settings_status_not_allowed">Not allowed</string>

    <!-- The Mac's folders in the phone's Files app, job 8 and
         docs/engine-contract.md item 19.

         A root's summary says how Ferry reaches that Mac right now. It is
         one of two keys: this one, with the transport named, or
         transport_not_reachable. The transport words are the ones
         TransportBadge already draws, so the Files app and the Devices
         screen say the same thing about the same device. -->
    <string name="documents_root_reachable">Reachable over %1$s</string>
    <!-- An app can ask for an open mode Ferry does not serve. The mode is
         the platform's own short string, so it is named as it arrives.
         Three parts, docs/voice.md rule 8: what stopped, why, what to
         do. -->
    <string name="documents_open_mode_unsupported">The file was not opened. Ferry does not serve the open mode %1$s. Open the file read only, or copy it first.</string>
    <string name="settings_location_label">Location</string>

    <!-- The Networks section, docs/engine-contract.md item 18. The current
         network can be trusted only once it is known; each trusted name
         can be removed on its own. -->
    <string name="settings_group_networks">Networks</string>
    <string name="settings_network_current_label">Current network</string>
    <string name="settings_network_trust">Trust this network</string>
    <string name="action_remove">Remove</string>
    <!-- The unknown case: distinct from presence_quiet_on_network because
         the cause is different and this line offers a fix. -->
    <string name="settings_network_unknown_name">Ferry cannot read the network name.</string>
</resources>
