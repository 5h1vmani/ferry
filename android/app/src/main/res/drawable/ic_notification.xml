<?xml version="1.0" encoding="utf-8"?>
<!-- The status bar and notification icon: the Ferry mark, white only,
     since Android recolours every notification icon's opaque pixels
     itself and reads only their alpha. Replaces the system's stock upload
     arrow. docs/audits/oss-looks.md M7.

     Same 24x24 geometry as design_ouput/logo_assets/ferry-mark.svg. The
     mark's clear space is already built into that grid, so it is used at
     1:1 scale here, with no further safe-zone scaling needed. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M8.4,8.1 H12.8 L15.6,10.9 V13.9 H8.4 V8.1 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M12.8,8.1 V10.9 H15.6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M4,13 H20 L17,18 H7 L4,13 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M2.5,19.2 H21.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeAlpha="0.26" />
    <path
        android:pathData="M2.5,19.2 H12"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
</vector>
