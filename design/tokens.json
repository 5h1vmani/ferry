{
  "font": {
    "family": "system",
    "note": "system means SF on macOS and Roboto on Android. A named family is a candidate to be judged by viewing. Changing this one value changes both apps."
  },
  "type": {
    "display": { "macos": "largeTitle", "android": "displaySmall", "weight": "semibold", "use": "the pairing code and nothing else" },
    "title":   { "macos": "title2",     "android": "titleLarge",   "weight": "semibold", "use": "screen and section titles" },
    "body":    { "macos": "body",       "android": "bodyLarge",    "weight": "regular",  "use": "most text" },
    "label":   { "macos": "callout",    "android": "labelLarge",   "weight": "medium",   "use": "badges and controls" },
    "caption": { "macos": "caption",    "android": "bodySmall",    "weight": "regular",  "use": "secondary lines such as last seen" },
    "mono":    { "macos": "body",       "android": "bodyLarge",    "weight": "regular",  "monospaced_digits": true, "use": "numbers that change while a person watches: speed, bytes remaining, the code" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },
  "radius": { "small": 4, "medium": 8, "large": 12 },
  "color_roles": {
    "note": "Each role names a step of a scale in colors.json. Radix documents what each step is for: 1-2 backgrounds, 3-5 component backgrounds, 6-8 borders, 9-10 solid accent, 11-12 text. There is no danger role: destructive is the platform's own, SwiftUI's destructive button role and Material's error colour, and a token would be a second answer to a question the platform has already answered.",
    "background":        { "scale": "gray",   "step": 1 },
    "surface":           { "scale": "gray",   "step": 2 },
    "surface_raised":    { "scale": "gray",   "step": 3 },
    "border":            { "scale": "gray",   "step": 6 },
    "border_strong":     { "scale": "gray",   "step": 8 },
    "text":              { "scale": "gray",   "step": 12 },
    "text_secondary":    { "scale": "gray",   "step": 11 },
    "accent":            { "scale": "accent", "step": 9 },
    "accent_hover":      { "scale": "accent", "step": 10 },
    "accent_surface":    { "scale": "accent", "step": 3 },
    "accent_border":     { "scale": "accent", "step": 7 },
    "accent_text":       { "scale": "accent", "step": 11 },
    "on_accent":         { "literal": "#ffffff" }
  },
  "icons": {
    "note": "Semantic name to the platform symbol name. SF Symbols on macOS, Material Symbols on Android. A view names a concept, never a glyph.",
    "device_phone":     { "macos": "iphone",                          "android": "smartphone" },
    "device_mac":       { "macos": "laptopcomputer",                  "android": "laptop_mac" },
    "usb":              { "macos": "cable.connector",                 "android": "usb" },
    "wifi":             { "macos": "wifi",                            "android": "wifi" },
    "not_reachable":    { "macos": "wifi.slash",                      "android": "wifi_off" },
    "advertising_off":  { "macos": "wifi.slash",                      "android": "wifi_off" },
    "paired":           { "macos": "checkmark.shield",                "android": "verified_user" },
    "transfer":         { "macos": "arrow.left.arrow.right",          "android": "sync_alt" },
    "paused":           { "macos": "pause.circle",                    "android": "pause_circle" },
    "failed":           { "macos": "exclamationmark.triangle",        "android": "error" },
    "done":             { "macos": "checkmark.circle",                "android": "check_circle" },
    "folder":           { "macos": "folder",                          "android": "folder" },
    "expand":           { "macos": "chevron.down",                    "android": "expand_more" },
    "forget":           { "macos": "trash",                           "android": "delete" },
    "settings":         { "macos": "gearshape",                       "android": "settings" },
    "pair":             { "macos": "plus.circle",                     "android": "add_circle" }
  }
}
